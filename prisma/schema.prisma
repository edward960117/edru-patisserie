generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  staff
  customer
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  name_cn     String
  emoji       String
  description String
  cakes       Cake[]
}

model Cake {
  id             Int        @id @default(autoincrement())
  category_id    Int
  category       Category   @relation(fields: [category_id], references: [id])
  name           String
  name_cn        String     @default("")
  slug           String     @unique
  description    String
  description_cn String     @default("")
  ingredients    String
  image_url      String
  lead_time_days Int
  featured       Boolean    @default(false)
  active         Boolean    @default(true)
  sizes          CakeSize[]
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
}

model CakeSize {
  id        Int      @id @default(autoincrement())
  cake_id   Int
  cake      Cake     @relation(fields: [cake_id], references: [id], onDelete: Cascade)
  size      String
  price     Float
  available Boolean  @default(true)
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  role          UserRole
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
}

enum OrderChannel {
  whatsapp
  wechat
  handwritten
  other
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

model Order {
  id                Int          @id @default(autoincrement())
  customer_name     String       @default("")
  customer_phone    String       @default("")
  cake_name         String       @default("")
  size              String       @default("")
  price             Float        @default(0)
  quantity          Int          @default(1)
  fulfillment       String       @default("")
  event_date        DateTime
  channel           OrderChannel @default(other)
  status            OrderStatus  @default(pending)
  notes             String       @default("")
  source_image_url  String       @default("")
  raw_extracted_text String      @default("")
  customer_id       Int?
  customer          Customer?    @relation(fields: [customer_id], references: [id])
  points_awarded    Boolean      @default(false)
  stripe_session_id String?      @unique
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
}

model Customer {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String   @default("")
  points        Int      @default(0)
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  orders        Order[]
}

